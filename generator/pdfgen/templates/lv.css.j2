/* Tradesman / construction quote in Leistungsverzeichnis style: serif, centred letterhead, OZ/EP/GP columns. */
@page {
  size: A4;
  margin: 24mm 18mm 28mm 22mm;
  @top-center { content: {{ (v.name ~ " – Angebot " ~ q.quote_number) | css }}; font: italic 8pt Georgia, "Times New Roman", "DejaVu Serif", serif; color: #555;
                vertical-align: bottom; padding-bottom: 4mm; }
  @bottom-center { content: element(footer); vertical-align: top; padding-top: 4mm; }
  @top-right { content: "Seite " counter(page) " von " counter(pages); font: 8pt Georgia, "DejaVu Serif", serif; color: #555;
               vertical-align: bottom; padding-bottom: 4mm; }
}
@page :first {
  margin-top: 14mm;
  @top-center { content: none; }
  @top-right { padding-bottom: 3mm; }
}

html { font-family: Georgia, "Times New Roman", "DejaVu Serif", serif; font-size: 9.2pt; line-height: 1.38; color: #1a1a1a; }
body { margin: 0; }
p { margin: 0 0 2mm; }

.footer { position: running(footer); width: 170mm; text-align: center; font-size: 6.4pt; color: #555; line-height: 1.5;
          border-top: 0.5pt solid {{ ident.accent }}; padding-top: 1.5mm; }

.letterhead { text-align: center; }
.letterhead .vname { font-size: 17pt; font-variant: small-caps; letter-spacing: 1pt; color: {{ ident.accent }}; }
.letterhead .rule { border-top: 0.6pt solid {{ ident.accent }}; border-bottom: 0.6pt solid {{ ident.accent }}; height: 0.8mm; margin: 1.5mm 15mm; }
.letterhead .vline { font-size: 7.5pt; color: #444; }

.head { display: flex; justify-content: space-between; margin-top: 14mm; }
.addr { width: 85mm; min-height: 38mm; font-size: 9.8pt; line-height: 1.3; }
.addr .return { font-size: 6.4pt; color: #555; border-bottom: 0.4pt solid #888; margin-bottom: 2mm; padding-bottom: 0.4mm; }
table.meta { font-size: 8.2pt; border-collapse: collapse; width: 68mm; }
table.meta td { padding: 0.2mm 0; vertical-align: top; }
table.meta td:first-child { color: #555; width: 25mm; }

h1 { font-size: 15pt; font-weight: normal; font-variant: small-caps; letter-spacing: 1.5pt; margin: 6mm 0 1mm; color: {{ ident.accent }}; }
table.project { border-collapse: collapse; margin-bottom: 4mm; }
table.project th { text-align: left; font-weight: bold; padding: 0 3mm 0.6mm 0; vertical-align: top; white-space: nowrap; }
table.project td { padding: 0 0 0.6mm; }
.intro { margin-bottom: 4mm; }

table.lv { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 8.8pt; }
.lv thead th { font-weight: bold; text-align: left; border-bottom: 1.2pt double #1a1a1a; padding: 1mm 1.2mm; font-size: 8.2pt; }
.lv th.num, .lv td.num { text-align: right; }
.lv td { padding: 1.8mm 1.2mm; vertical-align: top; }
.lv tbody.item { break-inside: avoid; }
.lv tbody.item td { border-bottom: 0.3pt solid #aaa; }
.lv .oz { width: 14mm; } .lv .qty { width: 16mm; } .lv .unit { width: 13mm; }
.lv .ep { width: 21mm; } .lv .gp { width: 24mm; }
.lv td.num { white-space: nowrap; }
.lv .short { font-weight: bold; }
.lv .long { margin-top: 0.8mm; text-align: justify; }
.lv .facts { font-size: 7.5pt; color: #555; margin-top: 0.6mm; font-style: italic; }
.lv .kind { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.6pt; color: {{ ident.accent }}; }
.lv tbody.optional td { background: #f6f4ef; }
.note { font-size: 7.8pt; font-style: italic; margin-top: 1.5mm; }

table.totals { margin: 4mm 0 0 auto; border-collapse: collapse; width: 100mm; break-inside: avoid; }
.totals th { text-align: left; font-weight: normal; padding: 0.6mm 2mm 0.6mm 0; }
.totals td { text-align: right; padding: 0.6mm 1mm; white-space: nowrap; }
.totals tr.line th, .totals tr.line td { border-top: 0.4pt solid #1a1a1a; }
.totals tr.grand th, .totals tr.grand td { font-weight: bold; font-size: 10pt; border-top: 0.8pt solid #1a1a1a; border-bottom: 2.4pt double #1a1a1a; padding: 1.2mm 1mm; }

.conditions { margin-top: 7mm; break-inside: avoid; }
.conditions em { font-style: italic; color: #333; }
.closing { margin-top: 5mm; break-inside: avoid; }
.closing .signature { margin-top: 9mm; }
.closing .signature span { font-size: 8pt; color: #555; }

.acceptance { margin-top: 9mm; border: 0.6pt solid #1a1a1a; padding: 3mm 4mm; break-inside: avoid; font-size: 8.5pt; }
.acceptance .title { font-variant: small-caps; font-size: 10.5pt; letter-spacing: 1pt; margin-bottom: 1.5mm; }
.acceptance .sign { display: flex; gap: 12mm; margin-top: 10mm; }
.acceptance .sign div { flex: 1; font-size: 7.5pt; color: #555; }
.acceptance .sign span { display: block; border-top: 0.5pt solid #1a1a1a; margin-bottom: 0.8mm; }
